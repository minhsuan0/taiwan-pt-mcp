# ==============================================================================
# Taiwan PT MCP Server 環境變數設定範例
# 複製此檔案為 .env 或在 MCP 客戶端 (Claude, Cursor, Antigravity) 的 env 區塊配置
# ==============================================================================

# 1. PubMed (NCBI) 官方 API Key（提高頻率限制：3 req/s → 10 req/s）
# 可至 https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/ 免費申請
NCBI_API_KEY=

# 2. 外部心跳檢測（Dead Man's Switch / 死人開關）
# 建議至 https://healthchecks.io 免費註冊建立 Check，取得專屬 Ping URL
# 若伺服器掛掉、斷電、卡死，超過預定時間未打卡，Healthchecks 會透過 Email/Telegram 發警報
HEARTBEAT_URL=https://hc-ping.com/your-uuid-here
# 心跳打卡間隔（毫秒，預設 120000 = 2 分鐘）
HEARTBEAT_INTERVAL_MS=120000

# 3. Telegram 每日狀態摘要報告（每日中午 12:00 自動推播）
# 透過 Telegram @BotFather 取得 Bot Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# 接收報告的 Chat ID 或頻道 ID（可使用 @userinfobot 查詢自己的 ID）
TELEGRAM_CHAT_ID=123456789

# 啟動時是否立即發送一則測試報告（true / false，預設 false）
TELEGRAM_TEST_ON_STARTUP=false
